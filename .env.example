# Replace the placeholders with your Atlas credentials. Never commit backend/.env.
MONGODB_URI=mongodb+srv://<username>:<password>@mydata.ruzvjqg.mongodb.net/coverStock?appName=MyData
PORT=3000
# Licensed MobileAPI.dev key for full device catalogue imports; never expose it to the app.
DEVICE_CATALOG_API_KEY=
# Optional: override only for a compatible catalog provider or test server.
DEVICE_CATALOG_BASE_URL=https://api.mobileapi.dev
# Respect provider rate limits. Increase if the provider returns HTTP 429.
DEVICE_CATALOG_MIN_REQUEST_INTERVAL_MS=12000
# Absolute path to a licensed/verified JSON array of MobileAPI IDs sold in India, e.g. [123, 456].
INDIA_DEVICE_ALLOWLIST_PATH=
